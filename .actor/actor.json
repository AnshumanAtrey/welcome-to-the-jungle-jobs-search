        },
        "keyValueStore": {
            "actorKeyValueStoreSchemaVersion": 1,
            "title": "Run summary",
            "description": "The OUTPUT record: how many jobs Welcome to the Jungle listed, read, matched and saved, the checked links, the notes about how the input was read and the settings used, the pay, size, industry and language filters included.",
            "collections": {
                "summary": {
                    "title": "Run summary (OUTPUT)",
                    "description": "Status, message, counts of jobs read, matched and saved, checked links, notes and settings.",
                    "key": "OUTPUT"
                }
